# Copy to mtga-account.env (gitignored) and fill in values.
# Do not commit real passwords to git.

MTGA_EMAIL=your-email@example.com
MTGA_PASSWORD=your-wizards-password
MTGA_DISPLAY_NAME=YourDisplayName

# Optional: mail.tm API (only if using disposable inbox on wshu.net)
MAILTM_ADDRESS=
MAILTM_PASSWORD=
